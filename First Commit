    /* BREAKING BANNER */
    .breaking {
      background: var(--red);
      color: #fff;
      text-align: center;
      padding: 10px 20px;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1rem;
      letter-spacing: 3px;
      animation: breakPulse 2s ease-in-out infinite;
    }
    @keyframes breakPulse { 0%,100%{background:#e84545;} 50%{background:#c0392b;} }

    /* HEADER */
    header {
      background: var(--gray);
      border-bottom: 3px solid var(--yellow);
      padding: 14px 24px;
      display: flex; align-items: center;
      justify-content: space-between;
      flex-wrap: wrap; gap: 12px;
    }
    .logo-area { display: flex; align-items: center; gap: 12px; }
    .logo-icon {
      width: 46px; height: 46px;
      background: var(--yellow); border-radius: 8px;
      display: flex; align-items: center; justify-content: center;
      font-size: 1.5rem;
    }
    .logo-text {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.7rem; letter-spacing: 3px;
      color: var(--yellow); line-height: 1;
    }
    .logo-sub {
      font-size: 0.62rem; color: var(--muted);
      letter-spacing: 2px; text-transform: uppercase;
    }
    .header-badge {
      background: var(--red); color: #fff;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 0.9rem; letter-spacing: 2px;
      padding: 6px 14px; border-radius: 4px;
      animation: blink 1.4s ease-in-out infinite;
    }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.4} }

    /* HERO */
    .hero {
      position: relative;
      padding: 70px 24px 50px;
      text-align: center; overflow: hidden;
    }
    .hero::before {
      content: '';
      position: absolute; top: -80px; left: 50%;
      transform: translateX(-50%);
      width: 700px; height: 700px;
      background: radial-gradient(circle, rgba(255,215,0,0.055) 0%, transparent 65%);
      pointer-events: none;
    }
    .hero-eyebrow {
      display: inline-block;
      background: var(--gray2);
      border: 1px solid var(--yellow);
      color: var(--yellow);
      font-size: 0.72rem; letter-spacing: 3px;
      text-transform: uppercase;
      padding: 6px 18px; border-radius: 100px;
      margin-bottom: 22px;
      animation: fadeDown 0.5s ease both;
    }
    .hero-headline {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(3.2rem, 10vw, 7.5rem);
      line-height: 0.95; letter-spacing: 2px;
      animation: fadeDown 0.65s ease both;
    }
    .hero-headline .yellow { color: var(--yellow); }
    .hero-headline .strike {
      text-decoration: line-through;
      color: var(--muted); font-size: 82%;
    }
    .hero-sub {
      font-size: clamp(1rem, 2.5vw, 1.3rem);
      color: #bbb; max-width: 540px;
      margin: 22px auto 0; line-height: 1.65;
      animation: fadeDown 0.8s ease both;
    }
    .hero-sub strong { color: var(--yellow); }

    /* GRAVESTONE */
    .grave-scene {
      margin: 48px auto 0;
      max-width: 400px;
      animation: fadeUp 1s ease both;
      position: relative;
    }
    .grave-glow {
      position: absolute; bottom: 28px; left: 50%;
      transform: translateX(-50%);
      width: 180px; height: 55px;
      background: radial-gradient(ellipse, rgba(255,210,50,0.15) 0%, transparent 75%);
      animation: glowPulse 2.6s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes glowPulse {
      0%,100%{opacity:0.55; transform:translateX(-50%) scaleX(1);}
      50%{opacity:1; transform:translateX(-50%) scaleX(1.18);}
    }
    .grave-plane {
      position: absolute; top: -38px; left: 50%;
      transform: translateX(-50%) rotate(18deg);
      font-size: 1.9rem;
      filter: grayscale(1) brightness(0.55);
      animation: floatPlane 3.2s ease-in-out infinite;
    }
    @keyframes floatPlane {
      0%,100%{transform:translateX(-50%) rotate(18deg) translateY(0);}
      50%{transform:translateX(-50%) rotate(18deg) translateY(-9px);}
    }

    /* TICKER */
    .ticker-wrap {
      background: var(--yellow);
      overflow: hidden; padding: 10px 0; margin-top: 52px;
    }
    .ticker {
      display: flex; white-space: nowrap;
      animation: tickScroll 22s linear infinite; gap: 52px;
    }
    .ticker span {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 0.95rem; letter-spacing: 3px;
      color: var(--black); flex-shrink: 0;
    }
    @keyframes tickScroll { 0%{transform:translateX(0);} 100%{transform:translateX(-50%);} }

    /* STATS */
    .stats-strip {
      display: flex;
      margin: 48px 24px 0;
      border: 1px solid var(--light-gray);
      border-radius: 12px; overflow: hidden;
    }
    .stat {
      flex: 1; padding: 22px 12px; text-align: center;
      border-right: 1px solid var(--light-gray);
      background: var(--gray);
    }
    .stat:last-child { border-right: none; }
    .stat-number {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 2.2rem; color: var(--yellow); line-height: 1;
    }
    .stat-label {
      font-size: 0.67rem; color: var(--muted);
      text-transform: uppercase; letter-spacing: 1.5px; margin-top: 5px;
    }

    /* CONTENT SECTIONS */
    .content-section {
      max-width: 720px;
      margin: 72px auto 0;
      padding: 0 24px;
    }
    .section-eyebrow {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 0.8rem; letter-spacing: 4px;
      color: var(--yellow); margin-bottom: 10px;
    }
    .section-title {
      font-family: 'Bebas Neue', sans-serif;
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      line-height: 1.05; margin-bottom: 28px;
    }

    /* TIMELINE */
    .timeline { list-style: none; position: relative; padding-left: 24px; }
    .timeline::before {
      content: '';
      position: absolute; left: 6px; top: 4px; bottom: 4px;
      width: 2px; background: var(--light-gray);
    }
    .timeline li {
      position: relative; padding: 0 0 28px 20px;
      font-size: 0.94rem; color: #bbb; line-height: 1.65;
    }
    .timeline li::before {
      content: '';
      position: absolute; left: -2px; top: 6px;
      width: 10px; height: 10px;
      border-radius: 50%; background: var(--yellow);
      border: 2px solid var(--black);
    }
    .timeline li:last-child { padding-bottom: 0; }
    .timeline li strong { color: var(--white); }
    .tl-date {
      display: inline-block;
      font-family: 'Bebas Neue', sans-serif;
      font-size: 0.78rem; letter-spacing: 2px;
      color: var(--yellow); margin-bottom: 4px;
    }

    /* ROUTES TABLE */
    .routes-card {
      background: var(--gray);
      border: 1px solid var(--light-gray);
      border-radius: 12px; overflow: hidden;
    }
    .routes-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: 14px 20px;
      border-bottom: 1px solid var(--light-gray);
      font-size: 0.9rem;
    }
    .routes-row:last-child { border-bottom: none; }
    .routes-row.hdr {
      background: var(--light-gray);
      font-size: 0.68rem; letter-spacing: 2px;
      text-transform: uppercase; color: var(--muted);
