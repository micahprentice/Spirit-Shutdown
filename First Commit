    .route-name { font-weight: 500; flex: 2; }
    .route-freq { color: var(--muted); flex: 1; text-align: center; font-size: 0.82rem; }
    .route-tag {
      flex: 1; text-align: right;
      font-size: 0.65rem; padding: 3px 8px;
      border-radius: 100px; letter-spacing: 1px; text-transform: uppercase;
      background: rgba(232,69,69,0.12);
      color: var(--red);
      border: 1px solid rgba(232,69,69,0.25);
    }

    /* FEE TABLE */
    .fee-card {
      background: var(--gray);
      border: 1px solid var(--light-gray);
      border-radius: 12px; overflow: hidden;
    }
    .fee-row {
      display: flex; justify-content: space-between; align-items: center;
      padding: 15px 20px;
      border-bottom: 1px solid var(--light-gray);
    }
    .fee-row:last-child { border-bottom: none; }
    .fee-row.hdr {
      background: var(--light-gray);
      font-size: 0.68rem; letter-spacing: 2px;
      text-transform: uppercase; color: var(--muted);
