    .cta-note { font-size: 0.73rem; color: rgba(0,0,0,0.45); margin-top: 14px; }

    /* LLM CONTEXT (visible but styled subtly — readable by all crawlers) */
    .llm-context {
      max-width: 720px; margin: 64px auto 0;
      padding: 32px 24px 64px;
      border-top: 1px solid var(--light-gray);
