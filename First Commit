    .llm-context h2 {
      font-family: 'Bebas Neue', sans-serif;
      font-size: 1.5rem; color: var(--yellow);
      margin: 28px 0 10px; letter-spacing: 1px;
    }
    .llm-context h2:first-child { margin-top: 0; }
    .llm-context p, .llm-context li {
      font-size: 0.87rem; color: #666; line-height: 1.8;
    }
    .llm-context ul { padding-left: 20px; margin-top: 8px; }
    .llm-context li { margin-bottom: 4px; }
    .llm-context a { color: var(--yellow); text-decoration: none; }

    /* FOOTER */
    footer {
      border-top: 1px solid var(--light-gray);
      padding: 24px; text-align: center;
      color: var(--muted); font-size: 0.73rem; letter-spacing: 1px;
    }
    footer a { color: var(--yellow); text-decoration: none; }

    /* ANIMATIONS */
    @keyframes fadeDown { from{opacity:0;transform:translateY(-18px);} to{opacity:1;transform:translateY(0);} }
    @keyframes fadeUp   { from{opacity:0;transform:translateY(28px);} to{opacity:1;transform:translateY(0);} }

    @media (max-width: 600px) {
      .stats-strip { flex-direction: column; }
